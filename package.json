{
  "name": "querykit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run --filter @querykitjs/core build && bun run --filter @querykitjs/zod build && bun run --filter @querykitjs/drizzle-pg build && bun run --filter @querykitjs/mongoose build && bun run --filter @querykitjs/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/*/{src,test}/**/*.{ts,json,md}\" \"*.{md,json}\"",
    "format:check": "prettier --check \"packages/*/{src,test}/**/*.{ts,json,md}\" \"*.{md,json}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && node scripts/pin-workspace-deps.mjs && node scripts/ci-publish.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,js,jsx,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.19.0"
  }
}
