{
  "name": "@querykitjs/mongoose",
  "version": "3.0.1",
  "description": "Advanced filtering + flexible pagination repository layer for Mongoose (MongoDB).",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/mongoose"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/mongoose#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun --preload ./test/bun-v8-shim.ts test/smoke.ts"
  },
  "dependencies": {
    "@querykitjs/core": "workspace:*"
  },
  "peerDependencies": {
    "mongoose": "^8.24 || ^9.11"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "mongoose": "9.11.4"
  },
  "keywords": [
    "mongoose",
    "mongodb",
    "repository",
    "pagination",
    "cursor",
    "keyset",
    "filter",
    "query",
    "odm",
    "typescript"
  ]
}
