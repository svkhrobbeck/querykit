{
  "name": "@querykit/core",
  "version": "1.0.0",
  "description": "ORM-agnostic query DSL shared by querykit packages — filters, operators & wire types.",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun run test/smoke.ts"
  },
  "keywords": [
    "querykit",
    "query",
    "filter",
    "dsl",
    "operators",
    "pagination",
    "typescript"
  ]
}
