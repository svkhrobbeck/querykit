{
  "name": "@querykitjs/prisma-pg",
  "version": "1.0.1",
  "description": "Advanced filtering + flexible pagination repository layer for Prisma (PostgreSQL).",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/prisma-pg"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/prisma-pg#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:generate": "prisma generate --schema test/prisma/schema.prisma",
    "test:query": "bun run test/query.ts",
    "test:types": "tsc --noEmit -p test/tsconfig.json",
    "test:contract": "bun --preload ../mongoose/test/_bun-v8-shim.ts test/contract.ts",
    "test:smoke": "bun run test/smoke.ts"
  },
  "dependencies": {
    "@querykitjs/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.1",
    "prisma": "^6.19.1"
  },
  "keywords": [
    "prisma",
    "postgres",
    "postgresql",
    "repository",
    "pagination",
    "cursor",
    "keyset",
    "filter",
    "query",
    "orm",
    "typescript"
  ]
}
