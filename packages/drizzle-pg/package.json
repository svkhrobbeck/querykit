{
  "name": "@querykitjs/drizzle-pg",
  "version": "2.0.0",
  "description": "Advanced filtering + flexible pagination repository layer for Drizzle ORM (PostgreSQL).",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/drizzle-pg"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/drizzle-pg#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:sql": "bun run test/sql.ts",
    "test:smoke": "bun run test/smoke.ts"
  },
  "dependencies": {
    "@querykitjs/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "postgres",
    "postgresql",
    "repository",
    "pagination",
    "cursor",
    "keyset",
    "filter",
    "query",
    "orm",
    "typescript"
  ]
}
