{
  "name": "@querykitjs/web",
  "version": "4.0.0",
  "description": "Frontend query-building for querykit — typed filters, pagination params & URL sync. Zero-dependency; you send the request.",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/web#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "skills/querykit-web",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun run test/smoke.ts",
    "test:hook": "bun run test/hook.ts"
  },
  "dependencies": {
    "@querykitjs/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19.2.7",
    "react-router": "^7.0 || ^8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "keywords": [
    "querykit",
    "query",
    "filter",
    "pagination",
    "cursor",
    "url-state",
    "search-params",
    "react",
    "frontend",
    "typescript"
  ]
}
