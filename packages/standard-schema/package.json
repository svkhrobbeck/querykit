{
  "name": "@querykitjs/standard-schema",
  "version": "0.0.0",
  "description": "Standard Schema v1 validators for the querykit request contract (filters, sort, pagination) — for valibot, arktype or Effect projects, Hono sValidator and tRPC. No validator library needed.",
  "type": "module",
  "author": {
    "name": "Suhrobbek Soatov",
    "url": "https://soatov.uz",
    "email": "svkhrobbeck@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svkhrobbeck/querykit.git",
    "directory": "packages/standard-schema"
  },
  "homepage": "https://github.com/svkhrobbeck/querykit/tree/main/packages/standard-schema#readme",
  "bugs": {
    "url": "https://github.com/svkhrobbeck/querykit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "skills/querykit-standard-schema",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test:smoke": "bun run test/smoke.ts"
  },
  "dependencies": {
    "@querykitjs/core": "workspace:*"
  },
  "keywords": [
    "querykit",
    "standard-schema",
    "validation",
    "valibot",
    "arktype",
    "hono",
    "trpc",
    "filter",
    "pagination",
    "typescript"
  ],
  "devDependencies": {
    "@hono/standard-validator": "0.4.0",
    "@standard-schema/spec": "1.1.0",
    "@trpc/server": "11.19.0",
    "hono": "4.13.13"
  }
}
